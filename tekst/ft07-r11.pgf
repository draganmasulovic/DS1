  \begin{pgfscope}
    \pgfpathmoveto{\pgfpointxy{650.0}{400.0}}
    \pgfpathlineto{\pgfpointxy{650.0}{250.0}}
    \pgfusepath{stroke}
  \end{pgfscope}
  \begin{pgfscope}
    \pgfsetfillcolor{white}
    \pgfpathellipse{\pgfpointxy{500.0}{250.0}}{\pgfpointxy{8.0}{0.0}}{\pgfpointxy{0.0}{8.0}}
    \pgfusepath{fill,stroke}
  \end{pgfscope}
  \begin{pgfscope}
    \pgfsetfillcolor{white}
    \pgfpathellipse{\pgfpointxy{650.0}{250.0}}{\pgfpointxy{8.0}{0.0}}{\pgfpointxy{0.0}{8.0}}
    \pgfusepath{fill,stroke}
  \end{pgfscope}
  \begin{pgfscope}
    \pgfsetfillcolor{white}
    \pgfpathellipse{\pgfpointxy{500.0}{400.0}}{\pgfpointxy{8.0}{0.0}}{\pgfpointxy{0.0}{8.0}}
    \pgfusepath{fill,stroke}
  \end{pgfscope}
  \begin{pgfscope}
    \pgfsetfillcolor{white}
    \pgfpathellipse{\pgfpointxy{650.0}{400.0}}{\pgfpointxy{8.0}{0.0}}{\pgfpointxy{0.0}{8.0}}
    \pgfusepath{fill,stroke}
  \end{pgfscope}
  \begin{pgfscope}
    \pgfsetfillcolor{white}
    \pgfpathellipse{\pgfpointxy{775.0}{325.0}}{\pgfpointxy{8.0}{0.0}}{\pgfpointxy{0.0}{8.0}}
    \pgfusepath{fill,stroke}
  \end{pgfscope}
  \pgftext[top,at={\pgfpointxy{500.0}{230.0}}]{2}

  \pgftext[bottom,at={\pgfpointxy{175.0}{562.0}}]{$a$}
  \pgftext[bottom,at={\pgfpointxy{400.0}{562.0}}]{$b$}
  \pgftext[right,at={\pgfpointxy{88.0}{475.0}}]{$a$}

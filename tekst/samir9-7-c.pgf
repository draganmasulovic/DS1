%% DO NOT FORGET TO \usepackage{pgf,acadpgf}
\begin{pgfpicture}
  \pgfsetxvec{\pgfpoint{\acadpgfunit}{0pt}}
  \pgfsetyvec{\pgfpoint{0pt}{\acadpgfunit}}
  \pgfsetlinewidth{\acadpgflinewidth}
  \pgftransformshift{\pgfpointxy{-340.504}{-108.434}}

  \begin{pgfscope}
    \pgfpathmoveto{\pgfpointxy{600.0}{200.0}}
    \pgfpathlineto{\pgfpointxy{773.205}{300.0}}
    \pgfpathlineto{\pgfpointxy{773.205}{500.0}}
    \pgfpathlineto{\pgfpointxy{600.0}{600.0}}
    \pgfpathlineto{\pgfpointxy{426.795}{500.0}}
    \pgfpathlineto{\pgfpointxy{426.795}{300.0}}
    \pgfpathclose
    \pgfusepath{stroke}
  \end{pgfscope}
  \begin{pgfscope}
    \pgfpathmoveto{\pgfpointxy{773.205}{500.0}}
    \pgfpathlineto{\pgfpointxy{426.795}{300.0}}
    \pgfusepath{stroke}
  \end{pgfscope}
  \begin{pgfscope}
    \pgfsetfillcolor{white}
    \pgfpathellipse{\pgfpointxy{600.0}{200.0}}{\pgfpointxy{8.0}{0.0}}{\pgfpointxy{0.0}{8.0}}
    \pgfusepath{fill,stroke}
  \end{pgfscope}
  \begin{pgfscope}
    \pgfsetfillcolor{white}
    \pgfpathellipse{\pgfpointxy{773.205}{300.0}}{\pgfpointxy{8.0}{0.0}}{\pgfpointxy{0.0}{8.0}}
    \pgfusepath{fill,stroke}
  \end{pgfscope}
  \begin{pgfscope}
    \pgfsetfillcolor{white}
    \pgfpathellipse{\pgfpointxy{773.205}{500.0}}{\pgfpointxy{8.0}{0.0}}{\pgfpointxy{0.0}{8.0}}
    \pgfusepath{fill,stroke}
  \end{pgfscope}
  \begin{pgfscope}
    \pgfsetfillcolor{white}
    \pgfpathellipse{\pgfpointxy{600.0}{600.0}}{\pgfpointxy{8.0}{0.0}}{\pgfpointxy{0.0}{8.0}}
    \pgfusepath{fill,stroke}
  \end{pgfscope}
  \begin{pgfscope}
    \pgfsetfillcolor{white}
    \pgfpathellipse{\pgfpointxy{426.795}{500.0}}{\pgfpointxy{8.0}{0.0}}{\pgfpointxy{0.0}{8.0}}
    \pgfusepath{fill,stroke}
  \end{pgfscope}
  \begin{pgfscope}
    \pgfsetfillcolor{white}
    \pgfpathellipse{\pgfpointxy{426.795}{300.0}}{\pgfpointxy{8.0}{0.0}}{\pgfpointxy{0.0}{8.0}}
    \pgfusepath{fill,stroke}
  \end{pgfscope}
  \pgftext[top,at={\pgfpointxy{600.0}{180.0}}]{1}
  \pgftext[top,at={\pgfpointxy{426.795}{280.0}}]{2}
  \pgftext[top,at={\pgfpointxy{773.205}{280.0}}]{5}
  \pgftext[bottom,at={\pgfpointxy{426.795}{520.0}}]{4}
  \pgftext[bottom,at={\pgfpointxy{773.205}{520.0}}]{10}
  \pgftext[bottom,at={\pgfpointxy{600.0}{620.0}}]{20}
\end{pgfpicture}
